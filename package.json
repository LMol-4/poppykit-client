{
  "name": "@poppykit/client",
  "version": "0.3.0",
  "private": false,
  "description": "Personal Agent Protocol client SDK",
  "repository": {
    "type": "git",
    "url": "https://github.com/LMol-4/poppykit-client.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "tsc",
    "pack": "pnpm pack",
    "test": "npm run build:tests && node scripts/run-checks.mjs all",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "build:tests": "node scripts/build-tests.mjs",
    "coverage": "npm run build && npm run build:tests && node scripts/coverage.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "pg": "8.23.1",
    "@types/pg": "8.23.1"
  },
  "files": [
    "dist",
    "README.md",
    "STORAGE.md",
    "AUTH.md",
    "DELIVERY.md",
    "PROVIDER.md",
    "INTEGRATIONS.md",
    "API.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "RELEASING.md",
    "examples",
    "LICENSE",
    "migrations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./provider": {
      "import": "./dist/provider.js",
      "types": "./dist/provider.d.ts"
    },
    "./provider/sqlite": {
      "import": "./dist/provider-sqlite.js",
      "types": "./dist/provider-sqlite.d.ts"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./provider/postgres": {
      "types": "./dist/provider-postgres.d.ts",
      "import": "./dist/provider-postgres.js"
    },
    "./adapter-contract": {
      "types": "./dist/adapter-contract.d.ts",
      "import": "./dist/adapter-contract.js"
    }
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "pg": "^8.23.1"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  }
}
