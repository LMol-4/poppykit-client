{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": ".test-build",
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "tests/**/*.mts",
    "test-support/**/*.mts",
    "scripts/**/*.mts"
  ]
}
